{
  "name": "tp-integrador-centro-medico",
  "version": "1.0.0",
  "description": "API REST para gestión de centro médico con telemedicina (turnos en SQL Server + métricas IoT en MongoDB). TP Integrador - Técnicas Avanzadas de la Programación (UP).",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:init": "node scripts/init-db.js",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "simulador": "node scripts/simulador-iot.js",
    "alertas": "node scripts/escuchar-alertas.js"
  },
  "author": "Agustín Werner",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "mssql": "^12.7.14",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
