# Copiar este archivo como .env y completar los valores.
# El .env NO se sube al repositorio (está en .gitignore).

# --- API ---
PORT=3000

# --- Autenticación (JWT) ---
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_EN=2h

# --- Clave de los dispositivos IoT (header x-api-key en POST /api/metricas) ---
IOT_API_KEY=cambiar-por-una-clave-de-dispositivo

# --- SQL Server ---
# Con Docker: localhost:1433, usuario sa y la clave de abajo (mínimo 8 caracteres, mayúscula, minúscula, número y símbolo).
SQL_SERVER=localhost
SQL_PORT=1433
SQL_USER=sa
SQL_PASSWORD=Cambiar!Esta1
SQL_DATABASE=CentroMedico
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# La imagen de SQL Server exige aceptar su licencia (EULA). Poner Y si la aceptás:
# https://go.microsoft.com/fwlink/?linkid=857698
MSSQL_ACCEPT_EULA=

# --- MongoDB ---
# Con Docker queda publicado en el puerto 27018 (para no chocar con un MongoDB instalado en la PC).
MONGO_URI=mongodb://localhost:27018/centro_medico
